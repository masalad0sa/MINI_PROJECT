PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/exam-proctoring
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d
FRONTEND_URL=http://localhost:5173
# Optional comma-separated origins for CORS (overrides/extends FRONTEND_URL)
FRONTEND_URLS=http://localhost:5173,http://127.0.0.1:5173
PYTHON_SERVICE_URL=http://localhost:8000
# Proctoring frame uploads are high frequency; keep this comfortably above your FPS.
PROCTORING_FRAME_LIMIT_PER_MIN=1200
